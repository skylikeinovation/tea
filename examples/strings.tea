fun main():
    // Teste de strings avançadas
    print("=== Strings Avançadas ===")
    
    val texto = "hello world"
    print("Original:", texto)
    
    val maiusculo = texto.upper()
    print("Maiúsculo:", maiusculo)
    
    val minusculo = maiusculo.lower()
    print("Minúsculo:", minusculo)
    
    val junto = "Hello" + " " + "World"
    print("Concatenado:", junto)
