fun main():
    // Teste de operações matemáticas inline
    print("=== Matemática Inline ===")
    
    val a = 10
    val b = 5
    
    val soma = a + b
    print("10 + 5 =", soma)
    
    val sub = a - b
    print("10 - 5 =", sub)
    
    val mult = a * b
    print("10 * 5 =", mult)
    
    val div = a / b
    print("10 / 5 =", div)
