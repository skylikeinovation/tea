fun main():
    // ========================================
    // EXEMPLO COMPLETO - Tea v0.3.0
    // ========================================

    print("=== BEM-VINDO AO TEA v0.3.0 ===")
    print("")

    // 1. VARIÁVEIS E STRINGS
    print("1. Variáveis e Strings:")
    val nome = "Tea"
    val versao = "0.3.0"
    val mensagem = "Linguagem " + nome + " v" + versao
    print(mensagem)
    print("")

    // 2. MATEMÁTICA INLINE
    print("2. Matemática Inline:")
    val a = 10
    val b = 5
    val soma = a + b
    val mult = a * b
    print("10 + 5 =", soma)
    print("10 * 5 =", mult)
    print("")

    // 3. ARRAYS
    print("3. Arrays:")
    val numeros = [1, 2, 3, 4, 5]
    print("Lista:", numeros)
    val primeiro = numeros[1]
    val terceiro = numeros[3]
    print("Primeiro:", primeiro)
    print("Terceiro:", terceiro)
    print("")

    // 4. DICIONÁRIOS
    print("4. Dicionários:")
    val pessoa = {nome: "João", idade: 25}
    print("Pessoa:", pessoa)
    print("")

    // 5. CONDICIONAIS
    print("5. Condicionais:")
    val x = 10
    if x > 5:
        print("x é maior que 5")
    endif
    print("")

    // 6. OPERADORES LÓGICOS
    print("6. Operadores Lógicos:")
    val y = 3
    if x > 5 and y < 10:
        print("x > 5 AND y < 10: verdadeiro")
    endif
    print("")

    // 7. FOR LOOP
    print("7. For Loop:")
    for i in range(3):
        print("  Iteração:", i)
    endfor
    print("")

    // 8. WHILE LOOP
    print("8. While Loop:")
    val contador = 0
    while contador < 3:
        print("  Contador:", contador)
        val contador = contador + 1
    endwhile
    print("")

    // 9. STRINGS AVANÇADAS
    print("9. Strings Avançadas:")
    val texto = "hello"
    val maiusculo = texto.upper()
    print("Original:", texto, "-> Maiúsculo:", maiusculo)
    print("")

    print("=== FIM DO EXEMPLO ===")
