// ============================================
// 🍵 Tea Language - Exemplo Completo
// ============================================
// Este arquivo mostra todas as funcionalidades do Tea
// Agora com sintaxe baseada em indentação (Python-style)
// ============================================

fun main():
    print("🍵 Bem-vindo ao Tea Language!")
    print("")
    
    // ============================================
    // 1. VARIÁVEIS
    // ============================================
    val nome = "João"
    val idade = 25
    val altura = 175
    
    print("Nome:", nome)
    print("Idade:", idade, "anos")
    
    print("")
    
    // ============================================
    // 2. OPERAÇÕES MATEMÁTICAS
    // ============================================
    val x = 10 + 5
    val y = x * 2
    val z = y / 3
    val w = z - 5
    
    print("Resultado:", w)
    print("")
    
    // ============================================
    // 3. CONDICIONAIS
    // ============================================
    val numero = 10
    
    if numero > 5:
        print("Número é maior que 5")
    elif numero == 5:
        print("Número é igual a 5")
    else:
        print("Número é menor que 5")
    
    print("")
    
    // ============================================
    // 4. OPERADORES LÓGICOS
    // ============================================
    val a = 10
    val b = 5
    
    if a > 5 and b < 10:
        print("Ambas condições são verdadeiras")
    
    if a == 0 or b == 0:
        print("Pelo menos um é zero")
    else:
        print("Nenhum é zero")
    
    if not a == 0:
        print("a não é zero")
    
    print("")
    
    // ============================================
    // 5. LOOPS - WHILE
    // ============================================
    print("Contando de 0 a 4:")
    val i = 0
    while i < 5:
        print(i)
        val i = i + 1
    
    print("")
    
    // ============================================
    // 6. LOOPS - FOR RANGE
    // ============================================
    print("For range de 0 a 4:")
    for j in range(5):
        print(j)
    
    print("")
    
    // ============================================
    // 7. ARRAYS (1-indexed como Lua)
    // ============================================
    val numeros = [1, 2, 3, 4, 5]
    val frutas = ["maçã", "banana", "laranja"]
    
    print("Primeiro número:", numeros[1])
    print("Segunda fruta:", frutas[2])
    
    print("")
    
    // ============================================
    // 8. FOR-IN (iterar sobre arrays)
    // ============================================
    print("Iterando sobre array:")
    for item in numeros:
        print("Item:", item)
    
    print("")
    
    // ============================================
    // 9. DICIONÁRIOS
    // ============================================
    val pessoa = {nome: "Maria", idade: 30, cidade: "SP"}
    print("Dicionário:", pessoa)
    
    print("")
    
    // ============================================
    // 10. STRINGS
    // ============================================
    val texto = "hello world"
    val maiusculo = texto.upper()
    val minusculo = texto.lower()
    
    print("Original:", texto)
    print("Maiúsculo:", maiusculo)
    print("Minúsculo:", minusculo)
    
    val saudacao = "Olá" + " " + "Mundo"
    print("Concatenado:", saudacao)
    
    print("")
    
    // ============================================
    // 11. GARBAGE COLLECTOR
    // ============================================
    gc.init()
    
    val temp = [1, 2, 3, 4, 5]
    
    gc.collect()
    
    print("")
    print("✅ Programa finalizado!")
