fun soma(a, b)
    val resultado = a + b
    return resultado
endfun

fun dobro(x)
    return x * 2
endfun

fun main()
    print("=== Funções com Parâmetros ===")
    print("")
    
    val x = soma(10, 5)
    print("soma(10, 5) =", x)
    
    val y = dobro(7)
    print("dobro(7) =", y)
    
    val z = soma(dobro(3), 4)
    print("soma(dobro(3), 4) =", z)
endfun
