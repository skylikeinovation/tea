// Módulo de funções matemáticas

fun double(x):
    val result = x * 2
    print("double(", x, ") =", result)
    result

fun triple(x):
    val result = x * 3
    print("triple(", x, ") =", result)
    result

fun square(x):
    val result = x * x
    print("square(", x, ") =", result)
    result

