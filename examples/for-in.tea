fun main():
    print("=== For-in sobre Arrays ===")
    print("")
    
    // Teste 1: Lista de números
    print("1. Lista de números:")
    val numeros = [10, 20, 30, 40, 50]
    for num in numeros:
        print("  Número:", num)
    endfor
    print("")
    
    // Teste 2: Lista de strings
    print("2. Lista de nomes:")
    val nomes = ["João", "Maria", "Pedro"]
    for nome in nomes:
        print("  Nome:", nome)
    endfor
    print("")
    
    // Teste 3: Lista pequena
    print("3. Lista pequena:")
    val cores = ["vermelho", "azul"]
    for cor in cores:
        print("  Cor:", cor)
    endfor
    print("")
    
    print("=== For-in funcionando! ===")
