fun main():
    print("=== Try/Except no Tea ===")
    print("")
    
    // Teste 1: Conversão com erro
    print("1. Tentando converter texto para número:")
    try:
        val opcao = int(input("Digite um número: "))
        print("Você digitou:", opcao)
    except:
        print("❌ Erro: Digite só números!")
    endtry
    
    print("")
    print("2. Programa continua normalmente!")
    print("=== Fim ===")
