// Teste de @include
@include("../libs/lib-cmd.lua")

fun main():
    cmd.clear()
    cmd.print_color("🍵 Tea Language - Test Include", "cyan")
    print("")
    
    cmd.menu("Menu Principal", {"Opção 1", "Opção 2", "Sair"})
    
    val opcao = cmd.input("Escolha: ")
    
    if opcao == "1":
        cmd.success("Você escolheu a opção 1!")
    elif opcao == "2":
        cmd.warning("Você escolheu a opção 2!")
    else:
        cmd.error("Opção inválida!")
    endif
    
    cmd.pause()
