fun main():
    print("=== Comparação: For Range vs For-in ===")
    print("")
    
    // For com range (0 até n-1)
    print("1. For com range(5):")
    for i in range(5):
        print("  i =", i)
    endfor
    print("")
    
    // For-in sobre array
    print("2. For-in sobre array:")
    val lista = [100, 200, 300, 400, 500]
    for valor in lista:
        print("  valor =", valor)
    endfor
    print("")
    
    // Exemplo prático: soma de lista
    print("3. Somando valores de uma lista:")
    val valores = [10, 20, 30, 40, 50]
    val soma = 0
    
    for v in valores:
        val soma = soma + v
    endfor
    
    print("  Lista:", valores)
    print("  Soma total:", soma)
    print("")
    
    // Exemplo prático: contando elementos
    print("4. Contando elementos:")
    val frutas = ["maçã", "banana", "laranja", "uva"]
    val contador = 0
    
    for fruta in frutas:
        val contador = contador + 1
        print("  ", contador, "-", fruta)
    endfor
    
    print("  Total de frutas:", contador)
    print("")
    
    print("=== Tea v0.4.0 - For-in implementado! ===")
