// Teste da biblioteca cmd
// Uso: cmd.exe("comando")

fun main():
    print("🍵 Tea - Teste de cmd.exe()")
    print("")
    
    // Exemplo 1: Listar arquivos
    print("📁 Listando arquivos:")
    cmd.exe("ls -la")
    
    print("")
    
    // Exemplo 2: Comando com aspas
    print("📝 Echo com aspas:")
    cmd.exe("echo 'Olá do Tea!'")
    
    print("")
    
    // Exemplo 3: Git status
    print("🔧 Git status:")
    cmd.exe("git status")
