fun main():
    // Teste de operadores lógicos
    print("=== Operadores Lógicos ===")
    
    val x = 10
    val y = 5
    
    if x > 5 and y < 10:
        print("x > 5 AND y < 10: verdadeiro")
    endif
    
    if x < 5 or y < 10:
        print("x < 5 OR y < 10: verdadeiro")
    endif
    
    val condicao = 0
    if not condicao:
        print("NOT 0: verdadeiro")
    endif
