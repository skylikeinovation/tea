fun main():
    // Teste de arrays
    print("=== Teste de Arrays ===")
    
    val lista = [1, 2, 3, 4, 5]
    print("Lista criada:", lista)
    
    val primeiro = lista[1]
    print("Primeiro elemento:", primeiro)
    
    val terceiro = lista[3]
    print("Terceiro elemento:", terceiro)
    
    val ultimo = lista[5]
    print("Último elemento:", ultimo)
